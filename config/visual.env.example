# Client visual overlays on top of the stock 1.12 Data/ MPQs.
# Copy to benilla-config/visual.env (or run: tools/macos/apply-visual.sh <profile>).
#
# Profiles are folders under $WOW_DATA_ROOT/visual-patches/<name>/ containing
# one or more patch-?.MPQ files (single letter or digit; patch-10.MPQ is ignored).
# "vanilla" means no overlays — original creature models and textures.
#
# Examples after you drop the files yourself:
#   VISUAL_PROFILE=vanilla
#   VISUAL_PROFILE=reforged-creatures   # ../wow-data/visual-patches/reforged-creatures/patch-C.MPQ
#   VISUAL_PROFILE=improved-models      # ../wow-data/visual-patches/improved-models/patch-C.MPQ
#   VISUAL_PROFILE=hd                   # several patch-?.MPQ in that folder

VISUAL_PROFILE=vanilla
